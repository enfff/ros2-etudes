<?xml version="1.0"?>
<robot name="clown_car" xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- Define robot constants -->
    <xacro:property name="base_width" value="1.0" />
    <xacro:property name="base_length" value="2.0" />
    <xacro:property name="base_height" value="0.5" />

    <xacro:property name="wheel_radius" value="0.4" />
    <xacro:property name="wheel_width" value="0.2" />
    <xacro:property name="wheel_ygap" value="1.2" />
    <xacro:property name="wheel_zoff" value="0.0" />
    <xacro:property name="wheel_xoff" value="-0.5" />

    <xacro:property name="caster_xoff" value="0.8" />
    <xacro:property name="caster_zoff" value="-0.2" />
    <xacro:property name="imu_zoff" value="0.15" />
    <xacro:property name="lidar_zoff" value="0.25" />
    <xacro:property name="chassis_zoff" value="0.4" />

    <link name="base_footprint" />

    <joint name="base_footprint_to_chassis_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="chassis" />
        <origin xyz="0 0 ${chassis_zoff}" rpy="0 0 0" />
    </joint>


    <link name="chassis">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="1.14395" />
            <inertia ixx="0.095329" ixy="0.0" ixz="0.0" iyy="0.381317" iyz="0.0" izz="0.476646" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
        </collision>
    </link>

    <link name="imu_link" />

    <joint name="imu_joint" type="fixed">
        <parent link="chassis" />
        <child link="imu_link" />
        <origin xyz="0 0 ${imu_zoff}" rpy="0 0 0" />
    </joint>

    <link name="lidar_link" />

    <joint name="lidar_joint" type="fixed">
        <parent link="chassis" />
        <child link="lidar_link" />
        <origin xyz="0 0 ${lidar_zoff}" rpy="0 0 0" />
    </joint>

    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>1</always_on>
            <update_rate>1</update_rate>
            <visualize>true</visualize>
            <topic>/imu</topic>
        </sensor>
    </gazebo>

    <gazebo reference="lidar_link">
        <material>Gazebo/Blue</material>

        <sensor name="gpu_lidar" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <!-- <topic>lidar</topic> -->
            <laser_topic>lidar/scan</laser_topic>
            <point_cloud_topic>lidar/points</point_cloud_topic>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>640</samples>
                        <resolution>1</resolution>
                        <min_angle>-1.396263</min_angle>
                        <max_angle>1.396263</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>1</samples>
                        <resolution>0.01</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.08</min>
                    <max>10.0</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>
            <always_on>1</always_on>
            <visualize>true</visualize>
        </sensor>
    </gazebo>


    <link name="left_wheel">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="1.0" />
            <inertia ixx="0.043333" ixy="0.0" ixz="0.0" iyy="0.043333" iyz="0.0" izz="0.08" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}" />
            </geometry>
        </collision>
    </link>

    <joint name="left_wheel_joint" type="continuous">
        <origin xyz="${wheel_xoff} ${wheel_ygap / 2.0} ${wheel_zoff}" rpy="-1.5707 0 0" />
        <parent link="chassis" />
        <child link="left_wheel" />
        <axis xyz="0 0 1" />
    </joint>

    <gazebo reference="left_wheel">
        <material>Gazebo/Red</material>
    </gazebo>


    <link name="right_wheel">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="1.0" />
            <inertia ixx="0.043333" ixy="0.0" ixz="0.0" iyy="0.043333" iyz="0.0" izz="0.08" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}" />
            </geometry>
        </collision>
    </link>

    <joint name="right_wheel_joint" type="continuous">
        <origin xyz="${wheel_xoff} ${-wheel_ygap / 2.0} ${wheel_zoff}" rpy="-1.5707 0 0" />
        <parent link="chassis" />
        <child link="right_wheel" />
        <axis xyz="0 0 1" />
    </joint>

    <gazebo reference="right_wheel">
        <material>Gazebo/Red</material>
    </gazebo>


    <link name="caster">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="1.0" />
            <inertia ixx="0.016" ixy="0.0" ixz="0.0" iyy="0.016" iyz="0.0" izz="0.016" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="0.2" />
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="0.2" />
            </geometry>
        </collision>
    </link>

    <joint name="caster_wheel" type="continuous">
        <origin xyz="${caster_xoff} 0 ${caster_zoff}" rpy="0 0 0" />
        <parent link="chassis" />
        <child link="caster" />
        <axis xyz="1 1 1" />
    </joint>

    <gazebo reference="caster">
        <material>Gazebo/Green</material>
        <mu1 value="0.0" />
        <mu2 value="0.0" />
    </gazebo>


    <gazebo>
        <plugin
            filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>${wheel_ygap}</wheel_separation>
            <wheel_radius>${wheel_radius}</wheel_radius>
            <odom_publish_frequency>1</odom_publish_frequency>
            <topic>cmd_vel</topic>

            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>

        </plugin>
    </gazebo>

</robot>